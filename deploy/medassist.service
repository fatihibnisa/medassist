# /etc/systemd/system/medassist.service
[Unit]
Description=MedAssist web ilova
After=network.target

[Service]
Type=simple
User=medassist
WorkingDirectory=/opt/medassist
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/medassist/data

[Install]
WantedBy=multi-user.target
