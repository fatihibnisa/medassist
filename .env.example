# ===== MedAssist sozlamalari =====
# Nusxa oling: cp .env.example .env  — va qiymatlarni to‘ldiring.

NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# Saytingiz manzili (QR kod va SMS havolalari shu manzilga olib boradi)
PUBLIC_URL=https://medassist.uz
TRUST_PROXY=true

# MAJBURIY: kamida 32 belgili tasodifiy qiymat. Yaratish: openssl rand -hex 48
JWT_SECRET=

# Ma’lumotlar papkasi (SQLite baza + yuklangan fayllar)
DATA_DIR=./data

# Birinchi administrator (server birinchi ishga tushganda yaratiladi)
ADMIN_PHONE=998901234567
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# SMS: console (faqat logga yozadi) yoki eskiz (https://eskiz.uz)
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# AI (ixtiyoriy). Kalit bo‘lmasa, qoralamalar tibbiy qoidalar asosida tayyorlanadi.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_ENABLED=true

# Demo foydalanuvchilar (productionda false bo‘lsin!)
DEMO_SEED=false

# Google Search Console: "HTML tag" usulidagi content qiymati (ixtiyoriy)
GOOGLE_SITE_VERIFICATION=
